DATABASE_URL="postgresql://postgres:yourpassword@localhost:5433/pulsecheck"
JWT_SECRET="your-secret-here"
# 64-char hex (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical in backend/.env and worker/.env — backend encrypts, worker decrypts.
ENCRYPTION_KEY="replace-with-64-hex-chars"
REDIS_URL="redis://redis:6379"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"